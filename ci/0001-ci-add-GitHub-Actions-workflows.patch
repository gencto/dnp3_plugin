+    schedule:
+      interval: weekly
diff --git a/.github/workflows/benchmark.yml b/.github/workflows/benchmark.yml
new file mode 100644
index 0000000..84a11dc
--- /dev/null
+++ b/.github/workflows/benchmark.yml
@@ -0,0 +1,35 @@
+name: Benchmarks
+
+on:
+  workflow_dispatch:
+  schedule:
+    - cron: "17 3 * * 1" # weekly, Monday 03:17 UTC
+
+jobs:
+  benchmark:
+    name: ${{ matrix.os }}
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, ubuntu-24.04-arm, macos-latest, windows-latest]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+      - uses: Swatinem/rust-cache@v2
+        with:
+          workspaces: native
+      - uses: dart-lang/setup-dart@v1
+        with:
+          sdk: stable
+      - run: dart pub get
+      - name: Run benchmarks
+        shell: bash
+        run: dart run benchmark/run_all.dart --out "results/${{ runner.os }}-${{ runner.arch }}.md"
+      - name: Summary
+        shell: bash
+        run: cat results/*.md >> "$GITHUB_STEP_SUMMARY"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: benchmark-${{ runner.os }}-${{ runner.arch }}
+          path: results/
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..d41b8eb
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,126 @@
+name: CI
+
+on:
+  push:
+    branches: [main, master]
+  pull_request:
+  workflow_dispatch:
+
+concurrency:
+  group: ci-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+env:
+  CARGO_TERM_COLOR: always
+
+jobs:
+  rust:
+    name: Rust · fmt, clippy, unit tests
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+        with:
+          components: rustfmt, clippy
+      - uses: Swatinem/rust-cache@v2
+        with:
+          workspaces: native
+      - run: cargo fmt --check
+        working-directory: native
+      - run: cargo clippy --all-targets --locked -- -D warnings
+        working-directory: native
+      - run: cargo test --locked
+        working-directory: native
+
+  dart:
+    name: Dart · ${{ matrix.os }}
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, ubuntu-24.04-arm, macos-latest, windows-latest]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+      - uses: Swatinem/rust-cache@v2
+        with:
+          workspaces: native
+      - uses: dart-lang/setup-dart@v1
+        with:
+          sdk: stable
+      - run: dart pub get
+      - run: dart analyze --fatal-infos
+      - name: Format
+        if: runner.os == 'Linux'
+        run: dart format --output=none --set-exit-if-changed -l 110 lib test hook benchmark example/master.dart example/outstation.dart example/worker_isolate.dart
+      # the build hook compiles native/ for the host
+      - run: dart test --reporter expanded --timeout 2x
+      - name: Quick benchmark
+        run: dart run benchmark/run_all.dart --quick --out bench.md
+      - name: Benchmark summary
+        shell: bash
+        run: cat bench.md >> "$GITHUB_STEP_SUMMARY"
+
+  native:
+    name: Native libraries
+    uses: ./.github/workflows/native-build.yml
+
+  flutter:
+    name: Flutter example · ${{ matrix.platform }}
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: ubuntu-latest
+            platform: android
+            build: apk --debug
+            targets: aarch64-linux-android armv7-linux-androideabi x86_64-linux-android
+          - os: ubuntu-latest
+            platform: linux
+            build: linux --debug
+            targets: x86_64-unknown-linux-gnu
+          - os: macos-latest
+            platform: ios
+            build: ios --debug --no-codesign
+            targets: aarch64-apple-ios aarch64-apple-ios-sim x86_64-apple-ios
+          - os: macos-latest
+            platform: macos
+            build: macos --debug
+            targets: aarch64-apple-darwin x86_64-apple-darwin
+          - os: windows-latest
+            platform: windows
+            build: windows --debug
+            targets: x86_64-pc-windows-msvc
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+      - name: Rust targets
+        shell: bash
+        run: rustup target add ${{ matrix.targets }}
+      - uses: Swatinem/rust-cache@v2
+        with:
+          workspaces: native
+          key: flutter-${{ matrix.platform }}
+      - if: matrix.platform == 'android'
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "17"
+      - if: matrix.platform == 'linux'
+        run: sudo apt-get update && sudo apt-get install -y ninja-build libgtk-3-dev
+      - uses: subosito/flutter-action@v2
+        with:
+          channel: stable
+          cache: true
+      - name: Enable native assets (no-op on Flutter versions where they are stable)
+        run: flutter config --enable-native-assets || true
+      - name: Generate platform folders
+        working-directory: example/flutter_app
+        run: flutter create --project-name dnp3_flutter_example --platforms ${{ matrix.platform }} .
+      - working-directory: example/flutter_app
+        run: flutter pub get
+      - working-directory: example/flutter_app
+        run: flutter analyze --no-fatal-infos
+      - working-directory: example/flutter_app
+        run: flutter build ${{ matrix.build }}
diff --git a/.github/workflows/native-build.yml b/.github/workflows/native-build.yml
new file mode 100644
index 0000000..061a346
--- /dev/null
+++ b/.github/workflows/native-build.yml
@@ -0,0 +1,89 @@
+# Reusable workflow: compiles the Rust bridge (native/) for every supported target and
+# uploads each library as an artifact laid out as `<rust-triple>/<library file>`, which is
+# exactly the structure expected by `DNP3_PREBUILT_DIR` / `native/prebuilt/`.
+name: native-build
+
+on:
+  workflow_call:
+    inputs:
+      profile:
+        description: cargo profile
+        type: string
+        default: release
+
+env:
+  CARGO_TERM_COLOR: always
+
+jobs:
+  build:
+    name: ${{ matrix.target }}
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          # Android (16 KB page size aligned)
+          - { os: ubuntu-latest, target: aarch64-linux-android, lib: libdnp3_dart.so, android: true }
+          - { os: ubuntu-latest, target: armv7-linux-androideabi, lib: libdnp3_dart.so, android: true }
+          - { os: ubuntu-latest, target: x86_64-linux-android, lib: libdnp3_dart.so, android: true }
+          - { os: ubuntu-latest, target: i686-linux-android, lib: libdnp3_dart.so, android: true }
+          # Apple
+          - { os: macos-latest, target: aarch64-apple-ios, lib: libdnp3_dart.dylib }
+          - { os: macos-latest, target: aarch64-apple-ios-sim, lib: libdnp3_dart.dylib }
+          - { os: macos-latest, target: x86_64-apple-ios, lib: libdnp3_dart.dylib }
+          - { os: macos-latest, target: aarch64-apple-darwin, lib: libdnp3_dart.dylib }
+          - { os: macos-latest, target: x86_64-apple-darwin, lib: libdnp3_dart.dylib }
+          # Linux
+          - { os: ubuntu-22.04, target: x86_64-unknown-linux-gnu, lib: libdnp3_dart.so }
+          - { os: ubuntu-22.04-arm, target: aarch64-unknown-linux-gnu, lib: libdnp3_dart.so }
+          # Windows
+          - { os: windows-latest, target: x86_64-pc-windows-msvc, lib: dnp3_dart.dll }
+          - { os: windows-latest, target: aarch64-pc-windows-msvc, lib: dnp3_dart.dll }
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: dtolnay/rust-toolchain@stable
+        with:
+          targets: ${{ matrix.target }}
+
+      - uses: Swatinem/rust-cache@v2
+        with:
+          workspaces: native
+          key: ${{ matrix.target }}
+
+      - name: Build (Android NDK)
+        if: matrix.android
+        working-directory: native
+        shell: bash
+        env:
+          RUSTFLAGS: -C link-arg=-Wl,-z,max-page-size=16384
+        run: |
+          cargo install cargo-ndk --locked
+          cargo ndk --target ${{ matrix.target }} --platform 21 build --profile ${{ inputs.profile }} --locked
+
+      - name: Build (Apple)
+        if: runner.os == 'macOS'
+        working-directory: native
+        env:
+          IPHONEOS_DEPLOYMENT_TARGET: "12.0"
+          MACOSX_DEPLOYMENT_TARGET: "10.14"
+          RUSTFLAGS: -C link-arg=-Wl,-install_name,@rpath/libdnp3_dart.dylib
+        run: cargo build --profile ${{ inputs.profile }} --locked --target ${{ matrix.target }}
+
+      - name: Build
+        if: ${{ !matrix.android && runner.os != 'macOS' }}
+        working-directory: native
+        run: cargo build --profile ${{ inputs.profile }} --locked --target ${{ matrix.target }}
+
+      - name: Stage
+        shell: bash
+        run: |
+          mkdir -p staging/${{ matrix.target }}
+          cp native/target/${{ matrix.target }}/${{ inputs.profile }}/${{ matrix.lib }} staging/${{ matrix.target }}/
+          ls -l staging/${{ matrix.target }}
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: native-${{ matrix.target }}
+          path: staging/
+          if-no-files-found: error
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..2b416f7
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,42 @@
+# On a version tag: build every native library, publish them as release assets and as a
+# single `dnp3-native-prebuilt.zip` that can be extracted to `native/prebuilt/` (or pointed
+# to with DNP3_PREBUILT_DIR) so applications do not need a Rust toolchain.
+name: Release
+
+on:
+  push:
+    tags: ["v*"]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  native:
+    uses: ./.github/workflows/native-build.yml
+
+  publish:
+    needs: native
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          pattern: native-*
+          path: prebuilt
+          merge-multiple: true
+      - name: Package
+        run: |
+          find prebuilt -type f | sort
+          (cd prebuilt && sha256sum $(find . -type f | sort) > SHA256SUMS)
+          (cd prebuilt && zip -r ../dnp3-native-prebuilt.zip .)
+      - uses: softprops/action-gh-release@v2
+        if: startsWith(github.ref, 'refs/tags/')
+        with:
+          files: |
+            dnp3-native-prebuilt.zip
+            prebuilt/SHA256SUMS
+          generate_release_notes: true
+      - uses: actions/upload-artifact@v4
+        with:
+          name: dnp3-native-prebuilt
+          path: dnp3-native-prebuilt.zip
